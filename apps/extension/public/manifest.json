{
  "manifest_version": 3,
  "name": "MD Reader",
  "version": "1.0.0",
  "description": "Mở file .md là đọc đẹp ngay. Soạn, chia đôi màn hình, trình chiếu, sơ đồ tư duy, xuất PDF/Word. Chạy hoàn toàn trên máy.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*.md",
    "*://*/*.md?*",
    "*://*/*.MD",
    "*://*/*.markdown",
    "*://*/*.markdown?*",
    "*://*/*.MARKDOWN",
    "*://*/*.mdown",
    "*://*/*.mdown?*",
    "*://*/*.MDOWN",
    "*://*/*.mkd",
    "*://*/*.mkd?*",
    "*://*/*.MKD",
    "*://*/*.mdx",
    "*://*/*.mdx?*",
    "*://*/*.MDX",
    "file:///*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*.md",
        "*://*/*.md?*",
        "*://*/*.MD",
        "*://*/*.markdown",
        "*://*/*.markdown?*",
        "*://*/*.MARKDOWN",
        "*://*/*.mdown",
        "*://*/*.mdown?*",
        "*://*/*.MDOWN",
        "*://*/*.mkd",
        "*://*/*.mkd?*",
        "*://*/*.MKD",
        "*://*/*.mdx",
        "*://*/*.mdx?*",
        "*://*/*.MDX",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open MD Reader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
