{
  "manifest_version": 3,
  "name": "MD Reader",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*.md",
    "*://*/*.MD",
    "*://*/*.markdown",
    "*://*/*.MARKDOWN",
    "*://*/*.mdown",
    "*://*/*.MDOWN",
    "*://*/*.mkd",
    "*://*/*.MKD",
    "*://*/*.mdx",
    "*://*/*.MDX",
    "file:///*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*.md",
        "*://*/*.MD",
        "*://*/*.markdown",
        "*://*/*.MARKDOWN",
        "*://*/*.mdown",
        "*://*/*.MDOWN",
        "*://*/*.mkd",
        "*://*/*.MKD",
        "*://*/*.mdx",
        "*://*/*.MDX",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open MD Reader"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "app.css"
      ],
      "matches": [
        "*://*/*.md",
        "*://*/*.MD",
        "*://*/*.markdown",
        "*://*/*.MARKDOWN",
        "*://*/*.mdown",
        "*://*/*.MDOWN",
        "*://*/*.mkd",
        "*://*/*.MKD",
        "*://*/*.mdx",
        "*://*/*.MDX",
        "file:///*"
      ]
    }
  ]
}
