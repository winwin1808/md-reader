{
  "manifest_version": 3,
  "name": "MD Reader",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*/*.md",
    "*://*/*.markdown",
    "file:///*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*.md",
        "*://*/*.markdown",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open MD Reader"
  },
  "web_accessible_resources": [
    {
      "resources": ["app.html", "app.css"],
      "matches": ["*://*/*", "file:///*"]
    }
  ]
}
