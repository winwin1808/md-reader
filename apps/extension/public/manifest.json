{
  "manifest_version": 3,
  "name": "MD Reader",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*.md",
    "*://*/*.MD",
    "*://*/*.markdown",
    "*://*/*.MARKDOWN",
    "*://*/*.mdown",
    "*://*/*.mkd",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*.md",
        "*://*/*.MD",
        "*://*/*.markdown",
        "*://*/*.MARKDOWN",
        "*://*/*.mdown",
        "*://*/*.mkd",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open MD Reader"
  },
  "web_accessible_resources": [
    {
      "resources": ["app.html", "app.css"],
      "matches": ["*://*/*", "file:///*"]
    }
  ]
}
