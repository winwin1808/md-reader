{
  "name": "md-reader-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "DOC_ROOM", "class_name": "DocRoom" }]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "md-reader", "database_id": "REPLACE_IN_8a2_4", "migrations_dir": "migrations" }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],
  "observability": { "enabled": true }
}
